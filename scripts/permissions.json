      "Read(~/.config/gh/**)",
      "Read(~/.railway-pilot/secrets/**)",
      "Bash(gh auth token *)",
      "Bash(git log * --output*)",
      "Bash(git diff * --output*)",
      "Bash(git show * --output*)",
      "Bash(railway delete *)",
      "Bash(railway down *)",
      "Bash(railway service delete *)",
      "Bash(railway environment delete *)",
      "Bash(railway volume delete *)",
      "Bash(railway volume detach *)",
      "Bash(railway bucket delete *)",
      "Bash(railway bucket credentials *)",
      "Bash(railway variable *)",
      "Bash(railway variables *)",
      "Bash(railway connect *)",
      "Bash(railway ssh *)",
      "Bash(railway run *)",
      "Bash(railway shell *)",
      "Bash(railway dev *)",
      "Bash(railway postgres pitr restore *)",
      "Bash(railway postgres pitr backup restore *)",
      "Bash(railway postgres pitr backup delete *)",
      "Bash(railway postgres pitr disable *)",
      "Bash(railway postgres pgbouncer remove *)",
      "Bash(railway usage limit set *)",
