{
  "permissions": {
    "additionalDirectories": [
      "~/.railway-pilot"
    ],
    "allow": [
      "Read(~/.railway-pilot/**)",
      "Edit(~/.railway-pilot/**)",
      "Bash(sh */scripts/railway-tools.sh status *)",
      "Bash(sh */scripts/railway-tools.sh logs *)",
      "Bash(railway --version *)",
      "Bash(railway whoami *)",
      "Bash(railway list *)",
      "Bash(railway status *)",
      "Bash(railway logs *)",
      "Bash(railway metrics *)",
      "Bash(railway usage *)",
      "Bash(railway templates search *)",
      "Bash(railway domain list *)",
      "Bash(railway domain status *)",
      "Bash(railway environment list *)",
      "Bash(railway environment config *)",
      "Bash(railway service list *)",
      "Bash(railway service status *)",
      "Bash(railway deployment list *)",
      "Bash(railway postgres pitr status *)",
      "Bash(railway postgres pitr progress *)",
      "Bash(railway postgres pitr backup list *)",
      "Bash(railway postgres pitr schedule list *)",
      "Bash(railway postgres history *)",
      "Bash(railway postgres ha status *)",
      "Bash(railway postgres pgbouncer status *)",
      "Bash(gh --version *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh search code *)",
      "Bash(gh search issues *)",
      "Bash(gh search prs *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh label list *)",
      "Bash(git --version *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)"
